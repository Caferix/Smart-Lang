<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/signInFragment">

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.scu.smartlang.presentation.ui.auth.SignInFragment"
        android:label="Giriş Yap"
        tools:layout="@layout/fragment_sign_in">

        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />

        <action
            android:id="@+id/action_signInFragment_to_navigation_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/main_nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.scu.smartlang.presentation.ui.auth.SignUpFragment"
        android:label="Hesap Oluştur"
        tools:layout="@layout/fragment_sign_up">

        <action
            android:id="@+id/action_signUpFragment_to_navigation_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/main_nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.scu.smartlang.presentation.ui.home.HomeFragment"
        android:label="Ana Sayfa"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_leaderboard"
        android:name="com.scu.smartlang.presentation.ui.leaderboard.LeaderboardFragment"
        android:label="Puan Durumu"
        tools:layout="@layout/fragment_leaderboard" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.scu.smartlang.presentation.ui.settings.SettingsFragment"
        android:label="Ayarlar"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/sentenceGameFragment"
        android:name="com.scu.smartlang.presentation.ui.sentence.SentenceGameFragment"
        android:label="Boşluk Doldurma"
        tools:layout="@layout/fragment_sentence_game" />

</navigation>