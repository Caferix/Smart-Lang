<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/sl_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Lottie Animasyonu -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieDialogIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_special_105"
            android:layout_marginBottom="16dp"/>

        <!-- Başlık -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tur Tamamlandı!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/sl_text_primary"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Açıklama -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harika gidiyorsun! Yeni sorularla devam etmek ister misin?"
            android:textSize="16sp"
            android:textColor="@color/sl_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- Butonlar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TEKRAR OYNA (Yeşil - Primary Action) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDialogRestart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Devam Et"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_sentence_option"
                android:backgroundTint="@color/sl_success"
                android:layout_marginBottom="12dp"/>

            <!-- MENÜYE DÖN (Mavi/Beyaz - Secondary Action) -->
            <!-- Değişiklik: Yazı düzeltildi, renk aktif hale getirildi -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDialogMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menüye Dön"
                android:textColor="@color/sl_primary"
                android:background="@drawable/button_sentence_option"
                android:backgroundTint="#FFFFFF"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>